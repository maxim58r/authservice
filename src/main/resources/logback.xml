<configuration>
    <property name="LOG_PATH" value="/var/log/myapp" />

    <!-- Консольный аппендер с минимальным уровнем -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Файловый аппендер для детальных логов -->
    <appender name="FILE_DEBUG" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/debug.log</file>
        <!-- ... настройки RollingPolicy, если нужно ... -->
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Корневой логер (только WARN и выше уходит в консоль) -->
    <root level="WARN">
        <appender-ref ref="CONSOLE"/>
    </root>

    <!-- Отдельный логер для детального уровня (INFO, DEBUG) -->
    <logger name="com.example.myapp" level="DEBUG" additivity="false">
        <appender-ref ref="FILE_DEBUG"/>
    </logger>
</configuration>